if(WIN32)
    add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/graphics" "${CMAKE_CURRENT_BINARY_DIR}/graphics")
    set(original "${PS3RECOMP_DIR}/libs/video/rsx_d3d12_backend.c")
    set(adapted "${CMAKE_CURRENT_BINARY_DIR}/graphics/rsx_d3d12_backend.c")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/graphics/adapt_graphics.py"
        "${original}" "${adapted}" COMMAND_ERROR_IS_FATAL ANY)
    get_target_property(sources ps3recomp_runtime SOURCES)
    if(NOT original IN_LIST sources)
        message(FATAL_ERROR "Audited D3D12 renderer missing from SDK target")
    endif()
    list(REMOVE_ITEM sources "${original}")
    list(APPEND sources "${adapted}")
    set_property(TARGET ps3recomp_runtime PROPERTY SOURCES "${sources}")
    target_link_libraries(ps3recomp_runtime PRIVATE d2_graphics)
endif()
