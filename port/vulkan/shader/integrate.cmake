find_package(Python3 COMPONENTS Interpreter REQUIRED)
set(D2_DXC_CACHE "${CMAKE_BINARY_DIR}/dxc-cache" CACHE PATH "Pinned DXC archive cache")
if(WIN32)
    set(dxc_platform windows)
else()
    set(dxc_platform linux)
endif()
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64)$")
    message(FATAL_ERROR "The pinned shader compiler package currently supports x64 only")
endif()
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/shader/fetch_dxc.py" "${D2_DXC_CACHE}" "${dxc_platform}" COMMAND_ERROR_IS_FATAL ANY)
set(dxc_root "${D2_DXC_CACHE}/${dxc_platform}")
add_library(d2_shader_compiler STATIC shader/compiler.cpp)
target_compile_features(d2_shader_compiler PUBLIC cxx_std_20)
target_include_directories(d2_shader_compiler PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/shader" PRIVATE "${dxc_root}/include")
target_compile_definitions(d2_shader_compiler PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
if(WIN32)
    enable_language(RC)
    target_link_libraries(d2_shader_compiler PRIVATE bcrypt)
else()
    target_compile_definitions(d2_shader_compiler PRIVATE D2_DXC_LIBRARY="${dxc_root}/libdxcompiler.so")
    target_link_libraries(d2_shader_compiler PRIVATE ${CMAKE_DL_LIBS})
endif()
set(D2_RSX_SDK_DIR "" CACHE PATH "Audited Windows SDK for synthetic RSX fixtures")
if(NOT EXISTS "${D2_RSX_SDK_DIR}/libs/video/rsx_vp_decompiler.c")
    message(FATAL_ERROR "Set D2_RSX_SDK_DIR to the SDK produced by tools/bootstrap_windows.py")
endif()
file(SHA256 "${D2_RSX_SDK_DIR}/libs/video/rsx_vp_decompiler.c" vp_hash)
file(SHA256 "${D2_RSX_SDK_DIR}/libs/video/rsx_fp_decompiler.c" fp_hash)
if(NOT vp_hash STREQUAL "7cf1603dbe8ff18689a537bb0b4c06786b78920f29dd48147fe70a178bdc486f" OR
   NOT fp_hash STREQUAL "f1c5e67b6a098019d8a790b5c3cd9035f311aea3860bc31af63bb718776dc903")
    message(FATAL_ERROR "Audited RSX decompiler source mismatch")
endif()
# No game shaders or bytecode are included. Fixture programs are assembled
# from documented instruction fields in the test executable.
add_library(d2_shader_fixture_decompilers STATIC
    "${D2_RSX_SDK_DIR}/libs/video/rsx_vp_decompiler.c"
    "${D2_RSX_SDK_DIR}/libs/video/rsx_fp_decompiler.c")
target_include_directories(d2_shader_fixture_decompilers PUBLIC "${D2_RSX_SDK_DIR}/include" "${D2_RSX_SDK_DIR}/libs/video")
add_library(d2_shader_fixtures STATIC shader/fixtures.cpp)
target_compile_features(d2_shader_fixtures PUBLIC cxx_std_20)
target_link_libraries(d2_shader_fixtures PUBLIC d2_shader_fixture_decompilers)
add_executable(DisgaeaD2RsxGpuProbe shader/gpu_probe.cpp)
target_link_libraries(DisgaeaD2RsxGpuProbe PRIVATE d2_shader_compiler d2_shader_fixtures d2_vulkan)
add_executable(DisgaeaD2ShaderCorpus shader/corpus_probe.cpp)
target_link_libraries(DisgaeaD2ShaderCorpus PRIVATE d2_shader_compiler d2_shader_fixtures)
target_include_directories(DisgaeaD2ShaderCorpus PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
add_executable(DisgaeaD2ShaderProbe shader/probe.cpp)
target_link_libraries(DisgaeaD2ShaderProbe PRIVATE d2_shader_compiler d2_shader_fixtures)
if(WIN32)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/embedded_dxc.rc" "201 RCDATA \"${dxc_root}/dxcompiler.dll\"\n")
    target_sources(DisgaeaD2ShaderProbe PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/embedded_dxc.rc")
    target_sources(DisgaeaD2RsxGpuProbe PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/embedded_dxc.rc")
    target_sources(DisgaeaD2ShaderCorpus PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/embedded_dxc.rc")
    target_compile_definitions(DisgaeaD2ShaderProbe PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    if(MSVC)
        set_property(TARGET d2_shader_compiler d2_shader_fixture_decompilers d2_shader_fixtures DisgaeaD2RsxGpuProbe DisgaeaD2ShaderCorpus DisgaeaD2ShaderProbe PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
    endif()
endif()
if(BUILD_TESTING)
    add_test(NAME rsx_shader_corpus COMMAND DisgaeaD2ShaderCorpus --self-test --output corpus-self-test)
    set_tests_properties(rsx_shader_corpus PROPERTIES TIMEOUT 120)
    add_test(NAME rsx_gpu_pixels COMMAND DisgaeaD2RsxGpuProbe --output rsx-gpu-check)
    set_tests_properties(rsx_gpu_pixels PROPERTIES TIMEOUT 120 SKIP_RETURN_CODE 77)
    add_test(NAME rsx_hlsl_spirv_compilation COMMAND DisgaeaD2ShaderProbe --output shader-check)
    set_tests_properties(rsx_hlsl_spirv_compilation PROPERTIES TIMEOUT 120)
endif()
